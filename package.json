{
  "name": "liaison",
  "private": true,
  "type": "module",
  "workspaces": [
    "."
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "setup-relay": "bun scripts/setup-relay.ts",
    "actors:dev": "bun scripts/vendor-actors.ts && cd actors && terse actor dev",
    "actors:gen": "terse actor generate --out-dir actors/generated --non-interactive",
    "actors:vendor": "bun scripts/vendor-actors.ts",
    "actors:deploy": "bun scripts/vendor-actors.ts && cd actors && terse deploy"
  },
  "dependencies": {
    "openai": "latest",
    "zod": "^3.23.8",
    "@relaycast/engine": "12.3.0",
    "@relaycast/sdk": "12.3.0",
    "terse-sdk": "0.14.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "terse-cli": "0.14.9"
  },
  "overrides": {
    "better-sqlite3": "^12.4.1"
  }
}
